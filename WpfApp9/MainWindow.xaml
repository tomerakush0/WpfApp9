<Window x:Class="WpfApp9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp9"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Image Source="/image/miss minutes.png" Height="150" Width="100"/>
            <TextBlock Text="מנהל המשימות שלי" FontWeight="Bold" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal">
                <Button Margin="305,0,10,0" Height="25" Width="100">
                    <TextBlock Text="משימות פעילות"/>
                </Button>
                <Button  Height="25" Width="100">
                    <TextBlock Text="משימות שהסתיימו"/>
                </Button>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <CheckBox Margin="0,100,0,10">
                <TextBlock Text="(לקנות חלב (דחיפות: גבוהה"/>
            </CheckBox>
            <CheckBox>
                <TextBlock Text="(ללמוד למבחן בלשון (דחיפות: בינונית"/>
            </CheckBox>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="משימה חדשה:"/>
            <TextBox Width="200" Margin="10,0"/>
            <ComboBox Margin="2,0" Width="100">
                <ComboBoxItem Content="נמוכה"/>
                <ComboBoxItem Content="בינונית"/>
                <ComboBoxItem Content="גבוהה"/>
            </ComboBox>
            <Button Width="60" Margin="10,0">
                <TextBlock Text="הוסף"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
